NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=your-openai-api-key

COZYLOGIC_IMAGE_MODEL=your-openai-image-model
COZYLOGIC_IMAGE_MODEL_FALLBACK=your-fallback-openai-image-model
COZYLOGIC_IMAGE_QUALITY=low
COZYLOGIC_IMAGE_SIZE=auto
COZYLOGIC_TEXT_MODEL=your-openai-text-model
OPENAI_IMAGE_MODEL=your-legacy-demo-openai-image-model

# Free Fix / rearrange_only only. These do not affect other budget tiers.
COZYLOGIC_FREE_FIX_IMAGE_MODEL=gpt-image-2
COZYLOGIC_FREE_FIX_IMAGE_QUALITY=medium
COZYLOGIC_FREE_FIX_IMAGE_SIZE=auto

# QA harness only; production routes do not read these variables.
COZYLOGIC_PRESERVATION_CANDIDATE_MODEL=gpt-image-2
COZYLOGIC_PRESERVATION_CANDIDATE_QUALITY=medium
COZYLOGIC_PRESERVATION_CANDIDATE_SIZE=auto
COZYLOGIC_PRESERVATION_INPUT_IMAGE=
AMAZON_ASSOCIATE_TAG=

DEV_BYPASS_LIMITS=your-local-dev-bypass-flag
PRUNE_HARD_DELETE=your-prune-hard-delete-flag
